---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '@daysite/components/Layout';
import { loadSite } from 'daysite/data';
import { localeLinksFor, localeIndexHref } from 'daysite/routes';
export async function getStaticPaths() {
  return (await getCollection('blog')).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { Content } = await render(post);
const data = await loadSite();
const locale = data.locales.find((item) => item.code === 'en')!;
---
<Layout site={data.site} current={locale} localeLinks={localeLinksFor(data.locales, localeIndexHref)}
  pagePath={`${import.meta.env.BASE_URL}en/blog/${post.id}/`} pageTitle={post.data.title}
  pageDescription={post.data.summary} favicons={data.favicons} vectorIcon={data.vectorIcon}>
  <article class="appfair-article" data-appfair-post>
    <h1>{post.data.title}</h1>
    <time datetime={post.data.published.toISOString()}>{new Intl.DateTimeFormat(locale.code, { dateStyle: 'long' }).format(post.data.published)}</time>
    <Content />
  </article>
</Layout>
